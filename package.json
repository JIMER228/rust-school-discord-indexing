{
  "name": "discord-forum-downloader",
  "version": "1.0.0",
  "description": "Discord bot for downloading all files from forum channels",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "npm run build && node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "clean": "rm -rf dist",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "discord",
    "bot",
    "forum",
    "downloader",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "discord.js": "^14.14.1",
    "fs-extra": "^11.2.0",
    "node-fetch": "^2.7.0",
    "tar": "^7.4.3",
    "yauzl": "^3.2.0",
    "node-rar": "^0.3.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.11.16",
    "@types/node-fetch": "^2.6.11",
    "@types/tar": "^6.1.13",
    "@types/yauzl": "^2.10.3",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
}
