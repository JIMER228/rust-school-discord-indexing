      "Font": "robotocondensed-bold.ttf",
      "Text Background Image": "https://i.ibb.co/23dgCkm/Group-2-7.png",
      "Text Alignment": 4,
      "Text Lines": [
        [
          "<size=16><color=#ffffff>Быстрый телепорт в город и бандитку <color=#8d8df2>(/otp | /btp)</color></color></size>",
          "<size=16><color=#ffffff>Оповещения о рейде в VK, Discord, Telegram, Rust+ <color=#8d8df2>(/raid)</color></color></size>",
          "<size=16><color=#ffffff>Ивент-турнир дуэли между игроками и командами!</color></size>",
          "<size=16><color=#ffffff>Автоматическое улучшение и починка всей базы <color=#8d8df2>(кнопки в шкафу)</color></color></size>",
          "<size=16><color=#ffffff>Автоматические двери! <color=#8d8df2>(/ad)</color></color></size>",
          "<size=16><color=#ffffff>Рюкзак <color=#8d8df2>(кнопка возле инвентаря)</color></color></size>",
          "\n",
          "\n",
          "<size=16><color=#ffffff>Улучшенный лут в ящиках и бочках!</color></size>",
          "<size=16><color=#ffffff>Продвинутая система кланов <color=#8d8df2>(/clans)</color></color></size>",
          "<size=16><color=#ffffff>Уникальный ивент конвой патрулирует местности по автодороге!</color></size>",
          "<size=16><color=#ffffff>Список авторизованных игроков в шкафу!</color></size>",
          "<size=16><color=#ffffff>DeathMessages список килов в верхнем правом углу!</color></size>",
          "<size=16><color=#ffffff>Отключён дамаг в зимнем биоме!</color></size>",
          "<size=16><color=#ffffff>Награды за присоединение к нашему Discord серверу деньги и наборы <color=#8d8df2>(/discord)</color></color></size>"
        ],
        [
          "<size=16><color=#ffffff>Удобное меню для управления друзьями <color=#8d8df2>(/f)</color></color></size>",
          "<size=16><color=#ffffff>Взлом ящика с чинука за 10 мин!</color></size>",
          "<size=16><color=#ffffff>Индикатор нанесённого урона по противнику и его состояния <color=#8d8df2>(/hitmarker on | off)</color></color></size>",
          "<size=16><color=#ffffff>Моментальное падение аирдропа!</color></size>",
          "<size=16><color=#ffffff>Моментальные транзакции в автоматах!</color></size>",
          "<size=16><color=#ffffff>Моментальный крафт для всех игроков!</color></size>",
          "\n",
          "\n",
          "<size=16><color=#ffffff>Моментальная очистка всего инвентаря <color=#8d8df2>(/cleaninv)</color></color></size>",
          "<size=16><color=#ffffff>Настраиваемый чат <color=#8d8df2>(/chat)</color></color></size>",
          "<size=16><color=#ffffff>Плагин на улучшение и удаление построек <color=#8d8df2>(/remove)</color></color></size>",
          "<size=16><color=#ffffff>Динамичное отображение PvP и рейд маркеров на G карте!</color></size>",
          "<size=16><color=#ffffff>Увеличенные рейты ресурсов, экскаваторов и карьеров X3!</color></size>",
          "<size=16><color=#ffffff>Вайп блок на сутки в начале каждого вайпа!</color></size>",
          "<size=16><color=#ffffff>Щедрые бесплатные наборы <color=#8d8df2>(/kit)</color></color></size>"
        ],
        [
          "<size=16><color=#ffffff>Бесплатные скины для всех игроков <color=#8d8df2>(/skin)</color></color></size>",
          "<size=16><color=#ffffff>Телепорт меню <color=#8d8df2>(/menu)</color></color></size>",
          "<size=16><color=#ffffff>7 уникальных ивентов <color=#8d8df2>(/event)</color></color></size>",
          "<size=16><color=#ffffff>Рейд блок <color=#8d8df2>(5 минут)</color></color></size>",
          "<size=16><color=#ffffff>Крафт вдалеке от верстака!</color></size>",
          "<size=16><color=#ffffff>Список игроков <color=#8d8df2>(/list)</color></color></size>",
          "\n",
          "\n",
          "<size=16><color=#ffffff>Указывающий маркер, <color=#8d8df2>(колесико мыши)</color></color></size>",
          "<size=16><color=#ffffff>Дополнительные радиостанции для кассетного магнитофона!</color></size>",
          "<size=16><color=#ffffff>Рандомный респавн!</color></size>",
          "<size=16><color=#ffffff>Report System и хорошая быстрая модерация <color=#8d8df2>(/report)</color></color></size>",
          "<size=16><color=#ffffff>Установка своих изображений в рамки <color=#8d8df2>(/sil https://site.jpg)</color></color></size>",
          "<size=16><color=#ffffff>Увеличенные стаки!</color></size>",
          "<size=16><color=#ffffff>Удобная система телепортов команды можно найти в разделе команды!</color></size>"
        ],
        [
          "<size=16><color=#ffffff>Трейд между игроками <color=#8d8df2>(/trade)</color></color></size>",
          "<size=16><color=#ffffff>Cортировка в ящиках три кнопки внизу!</color></size>",
          "<size=16><color=#ffffff>Магазин транспорта машина, коптер, итд. <color=#8d8df2>(/vb)</color></color></size>",
          "<size=16><color=#ffffff>Получение награды за вступление в группу ВК 125 руб после вайпа <color=#8d8df2>(/vk)</color></color></size>",
          "<size=16><color=#ffffff>Хороший античит!</color></size>",
          "<size=16><color=#ffffff>Инновационное меню для покраски домов <color=#8d8df2>(/bskin)</color></color></size>",
          "\n",
          "\n",
          "<size=16><color=#ffffff>Внутри игровой магазин <color=#8d8df2>(/shop)</color></color></size>",
          "<size=16><color=#ffffff>Детальная статистика игроков <color=#8d8df2>(/top)</color></color></size>",
          "<size=16><color=#ffffff>Дополнительное третье место на хвосте миникоптера!</color></size>",
          "<size=16><color=#ffffff>Ночная защита от рейдов 70% с 23 до 11 по мск!</color></size>",
          "<size=16><color=#ffffff>Приватная лошадь которая всегда будет у вас под рукой <color=#8d8df2>(/vm)</color></color></size>",
          "<size=16><color=#ffffff>Увеличенная скорость плавки печей  X25!</color></size>",
          "<size=16><color=#ffffff>Скорость переработчика  1 секунда!</color></size>",
          "<size=16><color=#ffffff>Оповещение о вайпе в <color=#8d8df2>(vk)</color></color></size>"
        ]
