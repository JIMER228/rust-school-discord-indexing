    {
      "Name": "КОМАНДЫ",
      "Icon": "https://rustplugins.net/products/welcomepanellite/1/rules_button.png",
      "Font Size": 12,
      "Font Color": "1 1 1 1",
      "Font Outline Color": "0 0 0 1",
      "Font Outline Thickness": "0.0",
      "Font": "robotocondensed-bold.ttf",
      "Text Background Image": "https://i.ibb.co/23dgCkm/Group-2-7.png",
      "Text Alignment": 4,
      "Text Lines": [
        [
          "<size=14><color=#8d8df2>/menu</color><color=#ffffff> - </color>Главное меню!</size>",
          "<size=14><color=#8d8df2>/damage количество</color><color=#ffffff> - </color>Команда для выбора X урона!</size>",
          "<size=14><color=#8d8df2>/hp количество</color><color=#ffffff> - </color>Команда для выбора количества жизни!</size>",
          "<size=14><color=#8d8df2>/regen set количество</color><color=#ffffff> - </color>Команда для выбора количество регена в секунду!</size>",
          "<size=14><color=#8d8df2>/raid</color><color=#ffffff> - </color>Оповещения о рейде в VK, Discord, Telegram, Rust+!</size>",
          "<size=14><color=#8d8df2>/ad</color><color=#ffffff> - </color>Включить/отключить автоматическое закрытие дверей!</size>",
          "<size=14><color=#8d8df2>/otp</color><color=#ffffff> - </color>Телепортироваться на аванпост!</size>",
          "<size=14><color=#8d8df2>/btp</color><color=#ffffff> - </color>Телепорт в лагерь бандитов!</size>",
          "\n",
          "\n",
          "<size=14><color=#8d8df2>/vb</color><color=#ffffff> - </color>Магазин транспорта машина, коптер, итд.!</size>",
          "<size=14><color=#8d8df2>/f</color><color=#ffffff> - </color>Список друзей и взаимодействия с ними!</size>",
          "<size=14><color=#8d8df2>/store</color><color=#ffffff> - </color>Забрать привилегию из корзины магазина rust-crom.ru !</size>",
          "<size=14><color=#8d8df2>/cleaninv</color><color=#ffffff> - </color>полностью очистить инвентарь!</size>",
          "<size=14><color=#8d8df2>/chat</color><color=#ffffff> - </color>открыть меню управления и настройки чата!</size>",
          "<size=14><color=#8d8df2>/backpack</color><color=#ffffff> - </color>Открыть рюкзак!</size>",
          "<size=13><color=#8d8df2>/pm [Ник] [Сообщение]</color><color=#ffffff> - </color>отправить игроку сообщение в личную переписку!</size>",
          "<size=13><color=#8d8df2>/r [Сообщение]</color></size><size=13><color=#ffffff> - </color>отправить сообщение игроку, который участвует с вами в личной переписке!</size>"
        ],
        [
          "<size=16><color=#8d8df2>/online</color><color=#ffffff> - </color>выводит список игроков в чат!</size>",
          "<size=16><color=#8d8df2>/transfer [Nick] [Amount]</color><color=#ffffff> - </color>передать валюту игроку!</size>",
          "<size=16><color=#8d8df2>/balance</color><color=#ffffff> - </color>просмотр баланса!</size>",
          "<size=16><color=#8d8df2>/remove</color><color=#ffffff> - </color>Улучшение удаления построек!</size>",
          "<size=16><color=#8d8df2>/block</color><color=#ffffff> - </color>Информация о блокировке предметов!</size>",
          "<size=16><color=#8d8df2>/kit</color><color=#ffffff> - </color>Получить начальный или платный набор!</size>",
          "\n",
          "\n",
          "<size=16><color=#8d8df2>/skin</color><color=#ffffff> - </color>Выбрать скины!</size>",
          "<size=16><color=#8d8df2>/event</color><color=#ffffff> - </color>Посмотреть ивенты!</size>",
          "<size=16><color=#8d8df2>/prize</color><color=#ffffff> - </color>забрать призы!</size>",
          "<size=16><color=#8d8df2>/list</color><color=#ffffff> - </color>Список и взаимодействие c игроками!</size>",
          "<size=16><color=#8d8df2>/report</color><color=#ffffff> - </color>Отправить жалобу на игрока!</size>",
          "<size=16><color=#8d8df2>/tpr ник</color><color=#ffffff> - </color>отправить запрос на телепортацию!</size>",
          "<size=16><color=#8d8df2>/tpa</color><color=#ffffff> - </color>принять запрос на телепортацию!</size>"
        ],
        [
          "<size=16><color=#8d8df2>/tpc</color><color=#ffffff> - </color>отменить телепортацию!</size>",
          "<size=16><color=#8d8df2>/sethome название дома</color><color=#ffffff> - </color>сохранить местоположение дома!</size>",
          "<size=16><color=#8d8df2>/home название дома</color><color=#ffffff> - </color>телепортироваться к местоположению дома!</size>",
          "<size=16><color=#8d8df2>/removehome название дома</color><color=#ffffff> - </color>удалить местоположение дома!</size>",
          "<size=16><color=#8d8df2>/homelist</color><color=#ffffff> - </color>открыть список всех сохраненных точек на карте!</size>",
          "<size=16><color=#8d8df2>/atp</color><color=#ffffff> - </color>Автоматическое принятие ТП!</size>",
          "\n",
          "\n",
          "<size=16><color=#8d8df2>/atp add Name</color><color=#ffffff> - </color>Добавление игрока в автопринятие.!</size>",
          "<size=16><color=#8d8df2>/atp remove Name</color><color=#ffffff> - </color>Удаление игрока со списка.!</size>",
          "<size=16><color=#8d8df2>/atp list</color><color=#ffffff> - </color>Список игроков автоприёма.!</size>",
          "<size=16><color=#8d8df2>/trade</color><color=#ffffff> - </color>Трейд между игроками!</size>",
          "<size=16><color=#8d8df2>/vk</color><color=#ffffff> - </color>Оповещение о вайпе в вк, награды за вступление в вк!</size>",
          "<size=16><color=#8d8df2>/info</color><color=#ffffff> - </color>Информация о сервере!</size>",
          "<size=16><color=#8d8df2>/shop</color><color=#ffffff> - </color>Внутриигровой магазин!</size>",
          "<size=16><color=#8d8df2>/top</color><color=#ffffff> - </color>Детальная статистика и топ игроков!</size>"
        ]
      ],
