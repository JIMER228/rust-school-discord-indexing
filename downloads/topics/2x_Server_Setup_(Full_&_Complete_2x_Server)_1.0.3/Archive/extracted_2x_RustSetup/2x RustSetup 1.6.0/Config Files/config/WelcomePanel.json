  "Text Tabs": [
    {
      "Name": "<size=22>HOME</size>",
      "Icon": "",
      "Font Size": 12,
      "Font Color": "1 1 1 1",
      "Font Outline Color": "0 0 0 1",
      "Font Outline Thickness": "0.5",
      "Font": "robotocondensed-bold.ttf",
      "Text Background Image": "",
      "Text Alignment": 3,
      "ScrollView Height": 0,
      "Text Lines": [
        [
          "<size=45><color=#c14229>YOURSERVER</color> 2X </size> ",
          "<size=25>WIPE SCHEDULE <color=#c142299f>WEEKLY/MONDAY</color> @ <color=#c142299f>8:00AM</color> (UTC+1)</size>",
          "<size=25>RATES <color=#c142299f>2x GATHER</color> | <color=#c142299f>2x LOOT</color></size> ",
          "<size=25>GROUP LIMIT <color=#c142299f>MAX 5</color></size>",
          "<size=25>MAPSIZE <color=#c142299f>3500</color></size> ",
          "\n",
          "\n",
          "<size=15>Server is located in EU. Feel free to browse our infomation panel to find out more about the server. If you have more questions, please join our discord and we will happy to help you.</size>",
          "\n",
          "<size=15>\n Enjoy your time!</size>"
        ]
      ],
      "Addon (plugin name)": ""
    },
    {
      "Name": "<size=22>RULES</size>",
      "Icon": "",
      "Font Size": 12,
      "Font Color": "1 1 1 1",
      "Font Outline Color": "0 0 0 1",
      "Font Outline Thickness": "0.5",
      "Font": "robotocondensed-regular.ttf",
      "Text Background Image": "",
      "Text Alignment": 4,
      "ScrollView Height": 0,
      "Text Lines": [
        [
          "<size=45><color=#c14229>Rules</color></size>",
          "",
          "<size=18>Do not use any third-party paid or free programs which provide an unfair advantage in-game. This includes scripts which can perform any action that is otherwise not possible to be performed ingame.</size>",
          "",
          "<size=18>Do not do anything to bypass a ban on our server(s). Do not try to join with a different account if you were banned, sit it out. Any try to do so will result in additional bans.</size>",
          "",
          "<size=18>Do not try to use any unfair advantages which were not intentially possible within the game. This includes but is not limited to accessing unaccessible areas and creating graphic errors or using graphical adjustments.</size>",
          "",
          "<size=18>Do not insult other players via text chat or any other applicable communication channel. We want a friendly and comfortable place for everyone on our server(s). Not following this rule will result into temporary or permanent restrictions, in extreme cases bans.</size>",
          "",
          "",
          ""
        ]
      ],
      "Addon (plugin name)": ""
    },
    {
      "Name": "<size=22>HELP</size>",
      "Icon": "",
      "Font Size": 12,
      "Font Color": "1 1 1 1",
      "Font Outline Color": "0 0 0 1",
      "Font Outline Thickness": "0.5",
      "Font": "robotocondensed-regular.ttf",
      "Text Background Image": "",
      "Text Alignment": 4,
      "ScrollView Height": 0,
      "Text Lines": [
        [
          "<size=20><color=#c14229>HELP & COMMANDS</color></size>",
          "",
          "<size=18><b>/kit</b>: to request kits (Free & VIP)</size>",
          "",
          "<size=18><b>/sethome</b> :nameofyourhome: & /home :nameofyourhome: : set a home point.</size>",
          "",
          "<size=18><b>/bandit</b>: Teleport to the bandit camp</size>",
          "",
          "<size=18><b>/remove</b>: allows players to remove entitites owned by himself</size>",
          "",
          "<size=18><b>/clanhelp</b>: to show all the commands regarding Clan control & creation</size>",
          "",
          "<size=18><b>/pm :name: :message:</b>: Will send a message privately to a player</size>",
          "",
          "<size=18><b>/trade :name:</b>: to make a trade with another player</size>",
          "",
          "<size=18><b>/bskin</b>: to open BuildingSkin Menu</size>",
          "",
          "<size=18><b>(VIP) /skinbox</b>: to use skinbox</size>",
          ""
        ]
      ],
      "Addon (plugin name)": ""
    },
    {
      "Name": "<size=22> KIT</size>",
