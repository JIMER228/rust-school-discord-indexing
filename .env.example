# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Discord forum channel ID (right click on forum channel -> Copy ID)
FORUM_CHANNEL_ID=123456789012345678

# Directory to save downloaded files
DOWNLOAD_DIR=downloads

# Maximum concurrent downloads (to avoid rate limits)
MAX_CONCURRENT_DOWNLOADS=5

# Delay between requests in milliseconds (to avoid rate limits)
REQUEST_DELAY=1000

# File filtering settings
# Only download files with these extensions (comma-separated)
ALLOWED_EXTENSIONS=.cs,.zip,.rar,.7z,.tar,.tar.gz

# Automatically extract archives and search for .cs files
EXTRACT_ARCHIVES=true